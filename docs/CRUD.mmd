flowchart TD
    A["Khách / Customer / Admin"] --> H["Home / Store: R sản phẩm public"]
    A --> GUEST{"Middleware guest"}
    GUEST -->|"Chưa đăng nhập"| REG["POST register: C User với role customer"]
    GUEST -->|"Đã đăng nhập"| HOME["Chuyển về Home"]
    A --> AUTH{"Middleware auth"}
    AUTH -->|"Chưa đăng nhập"| LOGIN["Chuyển trang login"]
    AUTH -->|"Đã đăng nhập"| ROLE{"Kiểm tra role"}
    ROLE -->|"admin"| AD["AdminMiddleware"]
    ROLE -->|"customer"| CU["CustomerMiddleware"]
    AD --> CAT["Category: C / R / U / D"]
    AD --> PRO["Product: C / R / U / D và ảnh"]
    AD --> DASH["Dashboard: R số liệu"]
    AD --> ORD["Order: R danh sách / U status"]
    CAT -->|"FK cascade khi D"| PRO
    CU --> CART["Session cart: C / R / U / D"]
    CART --> CHECK["Checkout: validation + transaction + lockForUpdate"]
    CHECK --> O["C Order"]
    CHECK --> I["C OrderItem"]
    CHECK --> STOCK["U Product.quantity: trừ tồn kho"]
    CHECK --> CLEAR["Xóa session cart sau thành công"]
    O --> SUCCESS["R chi tiết đơn mới nhất tại success"]
    CU --> HISTORY["R 10 đơn gần nhất chưa hủy của chính mình và OrderItem"]
    HISTORY --> CANCEL["U hủy đơn pending của mình"]
    CANCEL --> RESTORE["Transaction khóa Order/Product: hoàn stock một lần"]
    ORD --> STATE["pending → processing/cancelled; processing → completed/cancelled"]
    STATE --> RESTORE
    RESTORE --> FINAL["Order cancelled; không được đổi lại trạng thái"]
